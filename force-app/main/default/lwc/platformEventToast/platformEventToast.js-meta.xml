<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Platform Event Toast</masterLabel>
    <description>Toast notification component for Lightning pages</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__UtilityBar</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightning__AppPage,lightning__HomePage,lightning__UtilityBar">
            <property 
                name="toastTitle" 
                type="String" 
                label="Toast Title" 
                description="Title of the toast message"
                default="Welcome"/>
            <property 
                name="toastMessage" 
                type="String" 
                label="Toast Message" 
                description="Message to display. Use {recordId} to include record ID"
                default="Page loaded successfully"/>
            <property 
                name="toastVariant" 
                type="String" 
                label="Toast Variant" 
                datasource="success,error,warning,info"
                description="Toast style: success, error, warning, info"
                default="success"/>
            <property 
                name="toastMode" 
                type="String" 
                label="Toast Mode"
                datasource="dismissable,pester,sticky" 
                description="Toast behavior: dismissable, pester, sticky"
                default="dismissable"/>
            <property 
                name="showDelay" 
                type="Integer" 
                label="Show Delay (ms)" 
                description="Delay before showing toast in milliseconds"
                default="1000"
                min="0"
                max="10000"/>
            <property 
                name="showOnlyOnce" 
                type="Boolean" 
                label="Show Only Once Per Session" 
                description="If checked, toast will only show once per browser session for each record"
                default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
