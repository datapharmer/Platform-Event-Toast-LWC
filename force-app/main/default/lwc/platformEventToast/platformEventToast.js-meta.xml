<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Platform Event Toast</masterLabel>
    <description>Toast notification component that listens to platform events</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__UtilityBar</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property 
                name="toastTitle" 
                type="String" 
                label="Toast Title" 
                description="Override title for all toasts (optional)"
                default=""/>
            <property 
                name="toastMessage" 
                type="String" 
                label="Toast Message" 
                description="Override message for all toasts (optional)"
                default=""/>
            <property 
                name="toastVariant" 
                type="String" 
                label="Toast Variant" 
                description="Override variant: success, error, warning, info (optional)"
                default=""/>
            <property 
                name="toastKeys" 
                type="String" 
                label="Toast Keys (comma separated)" 
                description="Filter toasts by key values (optional)"
                default=""/>
            <property 
                name="toastMode" 
                type="String" 
                label="Toast Mode" 
                description="Override mode: dismissable, pester, sticky (optional)"
                default=""/>
            <property 
                name="runInSystemMode" 
                type="Boolean" 
                label="Run in System Mode" 
                description="If checked, toasts will be visible to all users regardless of who triggered them"
                default="false"/>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__UtilityBar">
            <property 
                name="toastTitle" 
                type="String" 
                label="Toast Title" 
                description="Override title for all toasts (optional)"
                default=""/>
            <property 
                name="toastMessage" 
                type="String" 
                label="Toast Message" 
                description="Override message for all toasts (optional)"
                default=""/>
            <property 
                name="toastVariant" 
                type="String" 
                label="Toast Variant" 
                description="Override variant: success, error, warning, info (optional)"
                default=""/>
            <property 
                name="toastKeys" 
                type="String" 
                label="Toast Keys (comma separated)" 
                description="Filter toasts by key values (optional)"
                default=""/>
            <property 
                name="toastMode" 
                type="String" 
                label="Toast Mode" 
                description="Override mode: dismissable, pester, sticky (optional)"
                default=""/>
            <property 
                name="runInSystemMode" 
                type="Boolean" 
                label="Run in System Mode" 
                description="If checked, toasts will be visible to all users regardless of who triggered them"
                default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
